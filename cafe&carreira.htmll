<script>
  const grandesAreas = [
    { nome:"Ciências Exatas e da Terra", icone:"🧮", cor:"#E8F0FE" },
    { nome:"Ciências Biológicas", icone:"🧬", cor:"#E6F3E6" },
    { nome:"Engenharias", icone:"⚙️", cor:"#FEF3E0" },
    { nome:"Ciências da Saúde", icone:"🏥", cor:"#FCE4E4" },
    { nome:"Ciências Agrárias", icone:"🌱", cor:"#E8F5E9" },
    { nome:"Ciências Sociais Aplicadas", icone:"📊", cor:"#F3E5F5" },
    { nome:"Ciências Humanas", icone:"🧠", cor:"#FFF8E1" },
    { nome:"Linguística, Letras e Artes", icone:"🎭", cor:"#FCE4EC" }
  ];
  document.getElementById('areasCatalogGrid').innerHTML = grandesAreas.map(area => `<div class="area-catalog-card" onclick="toggleMenu(); window.location.href='index.html'"><div class="area-catalog-img" style="background:${area.cor};">${area.icone}</div><div class="area-catalog-nome">${area.nome}</div></div>`).join('');
  function toggleMenu() { document.getElementById('areasGaveta').classList.toggle('aberta'); document.getElementById('btnMenu').classList.toggle('aberto'); }
</script>
